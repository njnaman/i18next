{
  "name": "i18next-typescript-migration",
  "version": "25.3.2",
  "type": "module",
  "description": "i18next internationalization framework - TypeScript migration",
  "main": "./dist/cjs/i18next.js",
  "module": "./dist/esm/i18next.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/esm/i18next.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/cjs/i18next.js"
      }
    }
  },
  "keywords": [
    "i18next",
    "internationalization",
    "i18n",
    "translation",
    "localization",
    "l10n",
    "globalization",
    "gettext",
    "typescript"
  ],
  "homepage": "https://www.i18next.com",
  "bugs": "https://github.com/i18next/i18next/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/i18next/i18next.git"
  },
  "dependencies": {
    "@babel/runtime": "^7.27.6"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.1",
    "@types/node": "^22.15.17",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^3.1.3",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vitest-globals": "^1.5.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "rollup": "^4.40.2",
    "sinon": "^19.0.5",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "scripts": {
    "build": "rimraf dist && rollup -c",
    "build:types": "tsc --emitDeclarationOnly",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage --run",
    "test:runtime": "vitest --project runtime",
    "test:compatibility": "vitest --project compatibility",
    "test:typescript": "vitest --project typescript",
    "test:local": "vitest --project local",
    "lint": "eslint src test --ext .ts",
    "lint:fix": "eslint src test --ext .ts --fix",
    "format": "prettier \"**/*.{ts,json,md}\" --check",
    "format:fix": "prettier \"**/*.{ts,json,md}\" --write",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --project tsconfig.test.json --noEmit",
    "clean": "rimraf dist"
  },
  "author": "Jan Mühlemann <jan.muehlemann@gmail.com> (https://github.com/jamuhl)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
